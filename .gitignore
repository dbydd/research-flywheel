# OS / editor
.DS_Store
*.lock

# pi local state
.pi/sessions/
.pi/hindsight/
.pi/schedule-prompts.json
.pi/schedule-prompts-settings.json

# onlyne 运行时状态（regenerate：onlyne server init / generate）
# spec.toml、templates/、AGENTS.md 是模板真相必须跟踪；其余 .onlyne/ 是运行时
# ws 目录整体是 generate 的产物，不跟踪；role 手帐写在 ws STATE.md，属运行时
.onlyne/*
!.onlyne/spec.toml
!.onlyne/AGENTS.md
!.onlyne/templates/
!.onlyne/templates/**
.onlyne.v0-archive/

# Obsidian（工作区即 vault）：笔记随树跟踪，机器态留本地
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/
.trash/

# 工具落盘
tools/scratch/*
!tools/scratch/.gitkeep
__pycache__/

# 笔记层本体在网盘（Obsidian 侧），这里只是软链，不进版本控制
blogs
papers
people
raw
wiki

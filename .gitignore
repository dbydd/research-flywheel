# OS / editor
.DS_Store
*.lock

# pi local state
.pi/sessions/
.pi/hindsight/
.pi/schedule-prompts.json

# onlyne v1 运行态（regenerate: onlyne server init / generate）
# spec.toml 与 templates/ 是模板真相必须跟踪；其余 .onlyne/ 是运行时
.onlyne/*
!.onlyne/spec.toml
!.onlyne/templates/
!.onlyne/templates/**
.onlyne.v0-archive/

# knowledge products (pool/, runs/, research/, papers/) stay tracked
!.gitkeep

# vault 软链（运行态，不入 git）
obsidian/

# 探针/拟合大二进制不入 git（可由 experiment/ 脚本再生；废弃口径见各 run DEPRECATED.md）
**/probes/
**/fits/
# Python 编译产物
__pycache__/
*.py[cod]

# skill 吸收暂存笔记（蒸馏工人落盘区，吸收完成后清）
.intake-notes/

# 训练槽锁（运行态）
.train-slot/

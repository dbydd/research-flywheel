# OS / editor
.DS_Store
*.lock

# pi local state
.pi/sessions/
.pi/hindsight/
.pi/schedule-prompts.json

# onlyne / swarm runtime state (regenerate with `onlyne-swarm init` + `workspace sync`)
# root 描述文件是模板本体，必须跟踪；其余 .onlyne/ 是运行时
.onlyne/*
!.onlyne/swarm.workspace.jsonc
.ws/
**/onlyne_in/
**/channels/loopback/{in,out}

# knowledge products (pool/, runs/, research/, papers/) stay tracked
!.gitkeep

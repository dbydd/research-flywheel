# OS / editor
.DS_Store
*.lock

# pi local state
.pi/sessions/
.pi/hindsight/
.pi/schedule-prompts.json
.pi/schedule-prompts-settings.json

# onlyne v1 runtime state (regenerate: onlyne server init / generate)
# spec.toml、templates/、AGENTS.md 是模板真相必须跟踪；其余 .onlyne/ 是运行时
# 例外：ws 下的 STATE.md 是 role 手写的记事，属手帐面必须跟踪（OneDrive 会静默换掉未跟踪文件）
.onlyne/*
!.onlyne/spec.toml
!.onlyne/AGENTS.md
!.onlyne/templates/
!.onlyne/templates/**
!.onlyne/ws/
.onlyne/ws/**
!.onlyne/ws/**/
!.onlyne/ws/**/STATE.md
.onlyne/ws/**/.pi/
.onlyne.v0-archive/

# Obsidian（工作区即 vault）：笔记随树跟踪，机器态留本地
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/
.trash/

# 工具落盘
tools/scratch/*
!tools/scratch/.gitkeep
__pycache__/

# 笔记层本体在网盘（Obsidian 侧），这里只是软链，不进版本控制
blogs
papers
people
raw
wiki/

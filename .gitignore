# OS / editor
.DS_Store
*.lock

# pi local state
.pi/sessions/
.pi/hindsight/
.pi/schedule-prompts.json
.pi/schedule-prompts-settings.json

# onlyne v1 runtime state (regenerate: onlyne server init / generate)
# spec.toml、templates/、AGENTS.md 是模板真相必须跟踪；其余 .onlyne/ 是运行时
.onlyne/*
!.onlyne/spec.toml
!.onlyne/AGENTS.md
!.onlyne/templates/
!.onlyne/templates/**
.onlyne.v0-archive/

# Obsidian（工作区即 vault）：笔记随树跟踪，机器态留本地
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/
.trash/

# 工具落盘
tools/scratch/*
!tools/scratch/.gitkeep
__pycache__/

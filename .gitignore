# OS / editor
.DS_Store
*.lock

# pi local state
.pi/sessions/
.pi/hindsight/
.pi/schedule-prompts.json
.pi/schedule-prompts-settings.json

# onlyne v1 runtime state (regenerate: onlyne server init / generate)
# spec.toml 与 templates/ 是模板真相必须跟踪；其余 .onlyne/ 是运行时
.onlyne/*
!.onlyne/spec.toml
!.onlyne/templates/
!.onlyne/templates/**
.onlyne.v0-archive/

# product surface (runs/) stays tracked
!.gitkeep

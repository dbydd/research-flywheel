{
  // Root workspace = supervisor node (maintenance-only). A human, or the
  // first Pi session opened here, owns the tree: first injection, config
  // maintenance, honest reporting. The work loop runs entirely between
  // roles (see AGENTS.md 宏观流); relay targets are always concrete role
  // names — `_root` stays functional but unused by convention.
  // Scheduler reads THIS file only for `retry`/`timeouts` (child copies are
  // model/edges overlays). Knobs (all optional, compiled defaults shown):
  //   "retry": {"max_attempts": N}            0 = unbounded replay sweep
  //   "timeouts": {"dispatched_secs": 120,    terminal-dead dispatch sweep
  //                "idle_secs": 60,           idle hop recycle
  //                "busy_secs": {"<role>": N}} per-role long-run cap, None = unlimited
  // ready gate is fixed 30s; busy_secs 0 disables the busy sweep.
  "$schema": "https://raw.githubusercontent.com/dbydd/onlyne-swarm/main/template.workspace.schema.json",
  "name": ".",
  "role": "你是 research flywheel 的 supervisor（管理者节点）。你不进工作环：取 idea 派工、归档 verdict、起新一轮都在 role 手里（宏观流见根目录 AGENTS.md），没有任何任务需要你推进。你只做维护：第一发注入（写 payload/ 后 onlyne-swarm submit --to <entry_role> --payload <file>）、idle 判定与报告、workspace create/sync、调度参数调整（改本文件的 retry/timeouts 键，重启 scheduler 生效）、知识产物 git commit、人机传话。先读 AGENTS.md，再查 .onlyne/ledger.jsonl 与 pool/ideas.jsonl 恢复现场，只读不写队列。如实报告 runs/ 路径、task_id、TUI/ledger 状态。你亲自写文件限于 runs/、pool/、payload/、.ws/ 配置与文档。",
  "model": { "provider": "", "model": "", "effort": "" },  // 装配时按主题填（role 模板同为空占位）
  "back_edges": []
}

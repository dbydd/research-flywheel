{
  // Marquee ring: five relay nodes a-e plus a supervisor root.
  // Generated state (.ws runtimes, .onlyne/{state,swarm}.db, ledger.jsonl,
  // ring.log) is created by `onlyne-swarm run`; only sources live in git.
  "$schema": "https://raw.githubusercontent.com/dbydd/onlyne-swarm/main/template.workspace.schema.json",
  "name": ".",
  "role": "Supervisor of the marquee ring. Fire a round by copying payload/round.md to a task id and `onlyne-swarm submit --to a --payload <file>`; the ring self-excites while the scheduler runs. Watch ring.log for repeated a b c d e cycles and the ledger for hop states. Cancel the live head task to stop the ring. You schedule and keep the books; you never write ring.log yourself.",
  "model": { "provider": "", "model": "", "effort": "" },
  "back_edges": [],
  // Dead-terminal/ready-timeout failures replay the task unchanged forever
  // (attempt+1). This is what keeps the ring running unattended.
  "retry": { "max_attempts": 0 }
}
